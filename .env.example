# ==============================================================================
# MedLab — Environment Configuration Template
# Document: .env.example
# All secrets must be provisioned via Railway / Vercel secrets management.
# NEVER commit real credentials or .env files to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (apps/web)
# ------------------------------------------------------------------------------
# Public browser-safe variables (prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only frontend variables (DO NOT prefix with NEXT_PUBLIC_)
# Optional service role key for trusted server-side SSR operations if required
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. BACKEND API CONFIGURATION (apps/api)
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=MedLab API
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL Connection (Supabase Transaction Pooler or Direct)
# Example: postgresql+psycopg://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth Verification & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=medical-documents

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenRouter AI Gateway Configuration
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_SECONDS=45

# AI Limits & Safety Controls
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_RETRIES=2

# File Upload Limits
UPLOAD_MAX_BYTES=26214440
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg

# Share Link Default TTL (seconds) - e.g., 86400 (24h)
SHARE_TOKEN_TTL_DEFAULT=86400

# ------------------------------------------------------------------------------
# 3. BACKGROUND WORKER CONFIGURATION (apps/api/app/workers)
# ------------------------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_TIMEOUT_SECONDS=120
